# Copy this file to test-app/.env before running `bun run test:integration`.
#
#   cp test-app/.env.example test-app/.env
#
# `.env` is gitignored, so a fresh clone or a new git worktree does not have one.
# `bun --env-file=` silently ignores a missing file, so without this copy the
# integration suites fall back to Bun's SQL defaults and fail with an opaque
# `database "<your-unix-user>" does not exist`. `bun run scripts/preflight-env.ts`
# runs first and catches that.

# Postgres used by the FSR store, list store, notify/watcher and sync-triggers
# suites. The role needs CREATE TABLE on this database — the suites create and
# drop their own fixtures. Any local database works; it does not have to be
# named `kiln_test`.
DATABASE_URL=postgresql://localhost:5432/kiln_test

# Redis used by RedisCache and the hub pub/sub suites.
# Pick a dedicated logical DB: Kiln cache keys (kiln:html:/, ...) are not
# namespaced per app, so two Kiln targets sharing db 0 collide on shared routes
# like "/".
REDIS_URL=redis://localhost:6379/1
